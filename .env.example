# Copy to .env and fill in from your Supabase project settings.
# NEVER commit .env — only this example file is tracked.
#
# Both of these are also required in the Vercel project env, because the
# link-preview edge middleware reads them at the edge. Without them, shared
# product links silently fall back to the generic homepage card.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Public site origin, no trailing slash. Used by the sitemap generator,
# the SEO hook and the edge middleware.
VITE_SITE_URL=https://PLACEHOLDER-DOMAIN.tld
