# Copy to .env and fill in from your Supabase project settings.
# NEVER commit .env — only this example file is tracked.
#
# Both of these are also required in the Vercel project env, because the
# link-preview edge middleware reads them at the edge. Without them, shared
# product links silently fall back to the generic homepage card.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Public site origin, no trailing slash, WITH the www — the apex has no DNS
# record. Used by the sitemap generator, the SEO hook and the edge middleware.
# All three already default to this value in code, so it only needs setting to
# override it (a preview deploy on its own origin).
VITE_SITE_URL=https://www.mondoshope.shop
